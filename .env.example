# Copy this file to ".env" and fill in both values. Never share or upload your real .env file.
SECRET_KEY=change-this-to-a-long-random-text
# Supabase: click "Connect" in your project and copy the Transaction pooler connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
